<% if record.errors.any? %>
  <div class="form-error" role="alert">
    <strong><%= pluralize record.errors.count, "problem" %> stopped this from saving:</strong>
    <ul>
      <% record.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
