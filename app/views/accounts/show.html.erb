<%# The owner's view of one customer: balance, the two actions, the ledger,
    and the audit trail. %>
<% locked = current_subscription&.write_locked? %>

<div class="with-rail">
  <div class="rail">
    <div class="rail__head">CUSTOMERS</div>
    <% current_shop.accounts.by_name.each do |account| %>
      <%= link_to account_path(account), class: "rail__item #{'is-active' if account == @account}" do %>
        <span class="avatar" style="width:32px;height:32px;font-size:13px"><%= account.display_name.first.upcase %></span>
        <span class="rail__name"><%= account.display_name %></span>
        <span class="rail__bal <%= balance_state account.balance_cents %>"><%= ngultrum account.balance_cents %></span>
      <% end %>
    <% end %>
  </div>

  <div class="with-rail__main">
    <div class="card card--pad">
      <div class="acct-head">
        <div class="avatar" style="width:48px;height:48px;font-size:20px"><%= @account.display_name.first.upcase %></div>
        <div class="acct-head__main">
          <div class="acct-head__name"><%= @account.display_name %></div>
          <div class="acct-head__meta">
            <%= @account.customer_phone.presence || "No phone" %><%= " · joined" if @account.joined? %>
          </div>
        </div>
        <%= link_to "Edit", edit_account_path(@account), class: "btn btn--tiny" %>
        <%= link_to account_statement_path(@account), class: "btn btn--tiny", style: "color:var(--brand)" do %>
          <%= icon :print, size: 16 %> Statement
        <% end %>
      </div>

      <div class="big-balance__label">
        <% if @account.balance_cents.positive? %>Outstanding balance
        <% elsif @account.in_credit? %>In credit (paid in advance)
        <% else %>Settled — nothing owed<% end %>
      </div>
      <div class="big-balance__row">
        <div class="big-balance__value <%= balance_state @account.balance_cents %>"><%= ngultrum @account.balance_cents %></div>
        <% if @account.overdue? %>
          <span class="badge badge--square badge--overdue" style="font-size:13px;padding:3px 10px">
            <%= pluralize @account.days_overdue, "day" %> overdue
          </span>
        <% end %>
      </div>

      <% if locked %>
        <div class="locked-note">
          Write actions are locked — renew the subscription in <%= link_to "Billing", subscription_path %> to record entries again.
        </div>
      <% end %>

      <%# When writing is locked these lead to Billing, not to a form that would
          only bounce the owner back with an alert. %>
      <div class="action-row">
        <%= link_to "Add credit", locked ? subscription_path : new_account_credit_path(@account),
              class: "btn btn--credit #{'is-locked' if locked}",
              style: "min-height:52px;font-size:16px;font-weight:600",
              title: locked ? "Renew the subscription to record credits" : nil %>
        <%= link_to "Record payment", locked ? subscription_path : new_account_payment_path(@account),
              class: "btn btn--payment #{'is-locked' if locked}",
              style: "min-height:52px;font-size:16px;font-weight:600",
              title: locked ? "Renew the subscription to record payments" : nil %>
        <%= link_to "Itemized purchase", locked ? subscription_path : new_account_credit_path(@account, mode: "itemized"),
              class: "btn btn--outline #{'is-locked' if locked}", style: "border-color:var(--brand)",
              title: locked ? "Renew the subscription to record purchases" : nil %>
      </div>
    </div>

    <% if @proofs.any? %>
      <div class="card">
        <div style="font-size:14px;font-weight:700;margin-bottom:10px">Payment proofs from this customer</div>
        <div class="chips">
          <% @proofs.each do |proof| %>
            <span class="chip chip--<%= proof.status %>">
              <%= ngultrum proof.amount_cents %> · <%= proof.status_label %> · <%= proof.created_at.strftime("%-d %b") %>
            </span>
          <% end %>
        </div>
        <% if @proofs.any?(&:pending?) %>
          <%= link_to "Review pending proofs", payment_proofs_path, class: "btn btn--quiet", style: "margin-top:12px" %>
        <% end %>
      </div>
    <% end %>

    <%= render "shared/queued_writes", account: @account %>

    <div class="card card--flush">
      <div class="card__head">Transaction history</div>
      <% if @ledger.any? %>
        <% @ledger.each do |transaction, running| %>
          <%= render "transactions/row", transaction: transaction, running: running, owner: true, locked: locked %>
        <% end %>
      <% else %>
        <div class="empty" style="border-top:1px solid var(--line)">
          <div class="empty__title">No transactions yet</div>
          Record the first credit or payment with the buttons above.
        </div>
      <% end %>
    </div>

    <div class="card card--flush">
      <div class="card__head">Invite <%= @account.customer_name %></div>
      <div class="rows">
        <%= link_to account_invite_path(@account), class: "row" do %>
          <div class="row__main">
            <div class="row__title"><%= @account.joined? ? "Invite link" : "Share the invite link" %></div>
            <div class="row__sub">
              <%= @account.joined? ? "Already linked to their own login" : "So they can watch their balance themselves" %>
            </div>
          </div>
          <span class="row__chev"><%= icon :chev_right, size: 18 %></span>
        <% end %>
      </div>
    </div>

    <% if @audit_events.present? %>
      <div class="card card--flush">
        <div class="card__head">Audit log</div>
        <% @audit_events.each do |event| %>
          <div style="border-top:1px solid var(--line);padding:10px 16px;display:flex;gap:10px;align-items:flex-start">
            <span class="tag tag--mono"><%= event.action %></span>
            <div style="flex:1;min-width:0">
              <div style="font-size:14px"><%= event.metadata["amount_cents"] ? ngultrum(event.metadata["amount_cents"]) : @account.display_name %></div>
              <div style="font-size:12px;color:var(--muted)">
                <%= event.created_at.strftime("%-d %b, %-l:%M %p") %> · <%= event.actor_name %>
              </div>
            </div>
          </div>
        <% end %>
        <div class="card__foot muted" style="font-size:12px">
          Append-only — the most recent events for this account.
        </div>
      </div>
    <% end %>
  </div>
</div>
