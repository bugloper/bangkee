<%# What the customer sees at one shop: read-only, plus the way to prove a
    transfer they have already made. %>
<div class="card card--pad">
  <div class="acct-head">
    <div class="avatar" style="width:48px;height:48px;font-size:20px"><%= @account.shop.name.first.upcase %></div>
    <div class="acct-head__main">
      <div class="acct-head__name"><%= @account.shop.name %></div>
      <div class="acct-head__meta">Your credit account</div>
    </div>
    <%= link_to account_statement_path(@account), class: "btn btn--tiny", style: "color:var(--brand)" do %>
      <%= icon :print, size: 16 %> <%= t("account.statement") %>
    <% end %>
  </div>

  <div class="big-balance__label">
    <% if @account.balance_cents.positive? %><%= t("account.you_owe") %>
    <% elsif @account.in_credit? %><%= t("account.paid_in_advance") %>
    <% else %><%= t("account.settled_nothing_owed") %><% end %>
  </div>
  <div class="big-balance__row">
    <div class="big-balance__value <%= balance_state @account.balance_cents %>"><%= ngultrum @account.balance_cents %></div>
    <% if @account.overdue? %>
      <span class="badge badge--square badge--overdue" style="font-size:13px;padding:3px 10px">
        <%= t("account.days_overdue", count: @account.days_overdue) %>
      </span>
    <% end %>
  </div>

  <% if @account.balance_cents.positive? %>
    <div class="action-row">
      <%= link_to t("account.upload_proof"), new_account_payment_proof_path(@account), class: "btn" %>
    </div>
  <% end %>
</div>

<% @open_tabs.to_a.each do |tab| %>
  <div class="card card--flush">
    <div class="card__head">
      <%= t("account.running_now", label: tab.label) %>
      <span class="count" style="background:var(--brand-tint);color:var(--brand-ink)">open</span>
    </div>
    <% if tab.tab_items.any? %>
      <div class="rows">
        <% tab.tab_items.order(:created_at).each do |item| %>
          <div class="row row--static">
            <div class="row__main">
              <div class="row__title"><%= item.name %></div>
              <div class="row__sub num"><%= item.quantity_label %> × <%= ngultrum item.unit_price_cents %></div>
            </div>
            <div class="row__amount num"><%= ngultrum item.total_cents %></div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="empty" style="padding:20px"><%= t("account.running_nothing_yet") %></div>
    <% end %>
    <div class="card__foot">
      <div class="kv">
        <span class="kv__key"><%= t("account.running_so_far") %></span>
        <span class="kv__val" style="font-size:18px"><%= ngultrum tab.total_cents %></span>
      </div>
      <div class="muted" style="font-size:13px;margin-top:6px">
        <%= t("account.running_note") %>
      </div>
    </div>
  </div>
<% end %>

<% if @bank_accounts.any? %>
  <div class="card">
    <div style="font-size:16px;font-weight:700;margin-bottom:8px"><%= t("account.how_to_pay", shop: @account.shop.name) %></div>
    <% @bank_accounts.each do |bank| %>
      <div style="padding:8px 0;border-top:1px solid var(--line)">
        <div style="font-weight:600"><%= bank.bank_name %><%= " · primary" if bank.primary? %></div>
        <div class="kv"><span class="kv__key"><%= t("account.account_name") %></span><span class="kv__val"><%= bank.account_name %></span></div>
        <div class="kv"><span class="kv__key"><%= t("account.account_number") %></span><span class="kv__val"><%= bank.account_number %></span></div>
        <% if bank.branch.present? %>
          <div class="kv"><span class="kv__key"><%= t("account.branch") %></span><span class="kv__val"><%= bank.branch %></span></div>
        <% end %>
        <% if bank.mobile_wallet.present? %>
          <div class="kv"><span class="kv__key"><%= t("account.mobile_wallet") %></span><span class="kv__val"><%= bank.mobile_wallet %></span></div>
        <% end %>
        <% if bank.instructions.present? %>
          <p class="muted" style="font-size:14px;margin-top:8px"><%= bank.instructions %></p>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>

<% if @proofs.any? %>
  <div class="card card--flush" data-controller="viewer">
    <%= render "shared/screenshot_viewer" %>
    <div class="card__head"><%= t("account.your_proofs") %></div>
    <div class="rows">
      <% @proofs.each do |proof| %>
        <div class="row row--static">
          <% if proof.screenshot.attached? %>
            <button class="thumb-button" data-action="viewer#open"
                    data-viewer-url="<%= url_for(proof.screenshot) %>"
                    data-viewer-caption="<%= ngultrum proof.amount_cents %> · <%= proof.created_at.strftime("%-d %b %Y") %>"
                    aria-label="View your screenshot">
              <%= image_tag proof.screenshot.variant(resize_to_limit: [ 128, 128 ]), class: "thumb", style: "width:44px;height:44px", alt: "" %>
            </button>
          <% end %>
          <div class="row__main">
            <div class="row__title"><%= ngultrum proof.amount_cents %></div>
            <div class="row__sub">
              <%= proof.created_at.strftime("%-d %b %Y") %><%
              %><% if proof.rejected? && proof.rejection_reason.present? %> · <%= proof.rejection_reason %><% end %>
            </div>
          </div>
          <span class="badge badge--<%= proof.confirmed? ? "payment" : (proof.rejected? ? "credit" : "pending") %>">
            <%= proof.status_label %>
          </span>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<div class="card card--flush">
  <div class="card__head"><%= t("account.transaction_history") %></div>
  <% if @ledger.any? %>
    <% @ledger.each do |transaction, running| %>
      <%= render "transactions/row", transaction: transaction, running: running, owner: false, locked: false %>
    <% end %>
  <% else %>
    <div class="empty" style="border-top:1px solid var(--line)">
      <div class="empty__title"><%= t("account.nothing_recorded_title") %></div>
      <%= t("account.nothing_recorded_body") %>
    </div>
  <% end %>
</div>
