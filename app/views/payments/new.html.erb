<% page_title "Record payment", back: account_path(@account) %>
<% content_for :content_class, "content--narrow" %>

<%= form_with model: @transaction, url: account_payments_path(@account),
              class: "card card--pad form-stack", data: { controller: "keypad" } do |form| %>
  <%= render "shared/errors", record: @transaction %>

  <div>
    <div class="amount-field__label">Amount received from <%= @account.display_name %></div>
    <div class="amount-field amount-field--payment">
      <div class="amount-field__box">
        <span class="amount-field__unit">Nu.</span>
        <%= form.text_field :amount, inputmode: "decimal", placeholder: "0", required: true,
              autofocus: true, "aria-label": "Amount in Ngultrum",
              data: { keypad_target: "input", action: "input->keypad#refresh" } %>
      </div>
    </div>
    <div class="muted" style="font-size:14px;margin-top:8px">
      Outstanding now: <span class="num owed"><%= ngultrum @account.balance_cents %></span>
    </div>
  </div>

  <div class="field">
    <span>How did they pay?</span>
    <div class="segmented">
      <% PaymentsController::METHODS.each do |method| %>
        <label>
          <%= form.radio_button :payment_method, method %>
          <span><%= method %></span>
        </label>
      <% end %>
    </div>
  </div>

  <div class="field">
    <%= form.label :notes, "Note" %>
    <span class="field__hint">Optional</span>
    <%= form.text_field :notes, placeholder: "e.g. paid at the shop" %>
  </div>

  <div class="field">
    <%= form.label :occurred_at, "Date" %>
    <span class="field__hint">Optional — defaults to now</span>
    <%= form.datetime_field :occurred_at %>
  </div>

  <div class="keypad">
    <% %w[1 2 3 4 5 6 7 8 9 . 0].each do |key| %>
      <button type="button" data-key="<%= key %>" data-action="keypad#press"><%= key %></button>
    <% end %>
    <button type="button" data-key="back" data-action="keypad#press" aria-label="Delete">⌫</button>
  </div>

  <%= form.submit "Save payment", class: "btn btn--payment" %>
  <%= link_to "Cancel", account_path(@account), class: "btn btn--quiet" %>
<% end %>
