<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions: only what the web app actually uses. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- An owner pins their shop on the map from where they stand (navigator.geolocation
         in web/src/components/shop-map.tsx). Asked for at that moment, never at launch. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- No CAMERA permission: photos for <input capture> are taken by the phone's camera
         app through ACTION_IMAGE_CAPTURE, which needs none. Declaring CAMERA would make
         Capacitor require it before opening the camera app. -->

    <!-- Android 11+ package visibility: Capacitor checks for a camera app with
         resolveActivity before photo capture. Links handed to other apps (web, tel:,
         sms:, mailto:) are started directly, so they need no query. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <!-- allowBackup/dataExtractionRules: the WebView's cookie store holds the session
         token, so app data is never backed up or transferred to another device. -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/AppTheme">

        <!-- configChanges: rotation, folding, resizing and dark-mode switches keep the
             same activity and WebView, so the page and its state survive them. -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Android App Links: password-reset emails (/passwords/<token>/edit) and
                 customer invites (/join/<token>) open in the app instead of the browser.
                 Verification needs /.well-known/assetlinks.json on the app host; until it
                 is there, Android keeps opening these links in the browser, which still
                 works. ${appLinkHost} comes from bangkee.appUrl (app/build.gradle). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="${appLinkHost}" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>
</manifest>
