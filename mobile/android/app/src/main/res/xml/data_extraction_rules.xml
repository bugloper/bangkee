<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing leaves the device in a cloud backup or a device-to-device
     transfer. The WebView's cookie store holds the session token, and a session
     copied to another phone would stay signed in there. People sign in again on a
     new phone instead. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
