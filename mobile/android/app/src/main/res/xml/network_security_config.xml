<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, trusting the system's certificate authorities and nothing else
     (no user-installed CAs). The debug build replaces this file to allow plain
     HTTP to the local development server; see src/debug/res/xml. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
