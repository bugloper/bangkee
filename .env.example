# Web Push (VAPID) — generate a pair with `bin/rails push:keys`.
# Push delivery is a logged no-op until these are set.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@bangkee.bt

# Where shop owners send their subscription payment (§17). Defaults live in
# app/models/operator_billing.rb.
# BANGKEE_BANK_NAME=Bank of Bhutan
# BANGKEE_ACCOUNT_NAME=Bangkee
# BANGKEE_ACCOUNT_NUMBER=1010 2030 4050
# BANGKEE_BRANCH=Thimphu Main
# BANGKEE_WALLET=mBoB 17 12 34 56
# BANGKEE_PRICE_CENTS=20000

# Notification email (§16.7). Development writes to tmp/mails instead.
# BANGKEE_HOST=bangkee.bt
# BANGKEE_MAIL_FROM=Bangkee <notifications@bangkee.bt>
# SMTP_ADDRESS=smtp.example.com
# SMTP_PORT=587
# SMTP_USER_NAME=
# SMTP_PASSWORD=

# Reading bank receipts shared into Bangkee (Claude vision). Without this the
# share flow still works — the confirm form just arrives empty.
ANTHROPIC_API_KEY=
